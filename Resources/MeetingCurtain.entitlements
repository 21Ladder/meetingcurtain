<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Sandbox enforces the app's promise: it reads the calendar and nothing else.
	     There is deliberately no com.apple.security.network.client, so macOS blocks every
	     network connection the process might try; Google sync is done by macOS itself. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
